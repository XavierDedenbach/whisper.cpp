# whisper.cpp dictation defaults
# WHISPER_HOME is auto-detected — only set if needed:
# WHISPER_HOME=/home/you/whisper.cpp
WHISPER_MODEL="small.en"
WHISPER_THREADS="4"

# Side-by-side binary build: build (CPU), build-cuda, or build-sycl.
WHISPER_BUILD_DIR="build"
# auto detects CUDA/SYCL from the build name or CMake cache; otherwise CPU.
# Explicit cuda or sycl is useful for a nonstandard build-directory name.
WHISPER_ACCELERATOR="auto"
WHISPER_ONEAPI_SETVARS="/opt/intel/oneapi/setvars.sh"
WHISPER_ONEAPI_DEVICE_SELECTOR="level_zero:gpu"
WHISPER_SYCL_DEVICE="0"
# Optional strict device-name substring (for example: Intel Iris Xe Graphics).
WHISPER_SYCL_EXPECTED_DEVICE=""

# cli = spawn whisper-cli per utterance (Option 1)
# server = warm whisper-server HTTP /inference (Option 2; enable companion systemd unit)
WHISPER_BACKEND="cli"
WHISPER_SERVER_URL="http://127.0.0.1:8178"
# Do one disposable inference before systemd marks the persistent server ready.
WHISPER_SERVER_WARMUP="1"
WHISPER_SERVER_WARMUP_AUDIO=""
WHISPER_SERVER_WARMUP_TIMEOUT="120"

# Accuracy helpers (passed to CLI and server)
WHISPER_LANGUAGE="en"
WHISPER_SUPPRESS_NST="1"
# Built from scripts/dictation/vocabulary.txt plus optional WHISPER_VOCABULARY_FILE.
WHISPER_PROMPT_PREFIX="Technical dictation:"
WHISPER_VOCABULARY_FILE="${HOME}/.config/whisper-dictation/vocabulary.txt"
WHISPER_CARRY_INITIAL_PROMPT="1"
# Fallback when no vocabulary file exists:
WHISPER_PROMPT="Technical dictation. Prefer accurate spelling of names and tools."

# Toggle: Ctrl+Space starts recording, Ctrl+Space again stops and pastes.
# Set HOTKEY_MODE=hold to use hold-to-talk instead.
HOTKEY_MODE="toggle"
HOTKEY_MODIFIERS="ctrl"
HOTKEY_KEY="space"

# PulseAudio/PipeWire source name (pactl list sources short). Empty = system default.
AUDIO_SOURCE=""

MIN_RECORD_SEC="0.4"
# Ignore stop toggle within this many seconds of start (prevents accidental double-tap).
MIN_TOGGLE_STOP_SEC="0.75"
# Legacy WAV-recorder slice length when CONTINUOUS_CAPTURE=0. On timeout, keep
# recording the next slice while the filled one transcribes in the background.
# 0 = unlimited single take.
MAX_RECORD_SEC="45"
# Robust long-form mode. One parecord process owns the microphone for the whole
# session; the daemon partitions its raw PCM at low-energy boundaries without
# dropping or duplicating samples. Requires parecord (pulseaudio-utils).
CONTINUOUS_CAPTURE="0"
STREAM_SEGMENT_TARGET_SEC="8"
STREAM_SEGMENT_MIN_SEC="7"
STREAM_SEGMENT_MAX_SEC="9"
# Inference-only padding, optional first-pass beam search, and optional encoder
# audio-context limit. Raw WAVs are never modified. Leave these portable defaults
# disabled; tune per machine/model. Audio context is continuous-mode-only and must
# cover STREAM_SEGMENT_MAX_SEC plus padding (Whisper uses about 50 tokens/second).
TRANSCRIPTION_TRAILING_SILENCE_SEC="0"
WHISPER_BEAM_SIZE=""
WHISPER_AUDIO_CTX=""
# Durable per-session WAV chunks and transcript.txt files. Audio is retained so
# a failed chunk can be retried and the rest of a long recording stays usable.
WHISPER_SESSION_DIR="${HOME}/.local/share/whisper-dictation/sessions"
# Server /inference curl budget. Stay below the server inference watchdog.
WHISPER_SERVER_TIMEOUT="90"
WHISPER_CLI_TIMEOUT="90"
# Restart whisper-server if an inference connection stays open this long (0 = disable).
WHISPER_INFERENCE_WATCHDOG_SEC="90"
# Recycle a healthy idle server this often to shed Intel GPU hangs (0 = disable).
WHISPER_SERVER_RECYCLE_SEC="21600"
# Minimum mic RMS (16-bit mono) before transcribing; blocks silence hallucinations.
MIN_AUDIO_RMS="80"
# PipeWire/Pulse capture latency (lower = less tail loss, slightly more CPU).
RECORDER_LATENCY_MSEC="20"
# After stop toggle, keep recording this long to flush in-flight audio into the WAV.
RECORDER_STOP_FLUSH_MSEC="120"
# Retained for older machine configs; delivery always uses one clipboard paste.
INSERT_METHOD="clipboard"

# Desktop notification dwell (milliseconds); each replaces the previous popup
NOTIFY_MS="1000"

# System tray dot in the top panel (gray idle, red blink while recording)
TRAY_INDICATOR="1"
INDICATOR_BLINK_SEC="1.0"
