# whisper.cpp dictation defaults
# WHISPER_HOME is auto-detected — only set if needed:
# WHISPER_HOME=/home/you/whisper.cpp
WHISPER_MODEL="small.en"
WHISPER_THREADS="4"

# cli = spawn whisper-cli per utterance (Option 1)
# server = warm whisper-server HTTP /inference (Option 2; enable companion systemd unit)
WHISPER_BACKEND="cli"
WHISPER_SERVER_URL="http://127.0.0.1:8178"

# Accuracy helpers (passed to CLI and server)
WHISPER_LANGUAGE="en"
WHISPER_SUPPRESS_NST="1"
# Built from WHISPER_VOCABULARY_FILE unless that file is missing (then WHISPER_PROMPT).
WHISPER_PROMPT_PREFIX="Technical dictation."
WHISPER_VOCABULARY_FILE="${HOME}/.config/whisper-dictation/vocabulary.txt"
WHISPER_CARRY_INITIAL_PROMPT="1"
# Fallback when vocabulary.txt does not exist:
WHISPER_PROMPT="Technical dictation. Prefer accurate spelling of names and tools."

# Toggle: Ctrl+Space starts recording, Ctrl+Space again stops and pastes.
# Set HOTKEY_MODE=hold to use hold-to-talk instead.
HOTKEY_MODE="toggle"
HOTKEY_MODIFIERS="ctrl"
HOTKEY_KEY="space"

# PulseAudio/PipeWire source name (pactl list sources short). Empty = system default.
AUDIO_SOURCE=""

MIN_RECORD_SEC="0.4"
# Ignore stop toggle within this many seconds of start (prevents accidental double-tap).
MIN_TOGGLE_STOP_SEC="0.75"
# Minimum mic RMS (16-bit mono) before transcribing; blocks silence hallucinations.
MIN_AUDIO_RMS="80"
# PipeWire/Pulse capture latency (lower = less tail loss, slightly more CPU).
RECORDER_LATENCY_MSEC="20"
# After stop toggle, keep recording this long to flush in-flight audio into the WAV.
RECORDER_STOP_FLUSH_MSEC="120"
INSERT_METHOD="clipboard"
