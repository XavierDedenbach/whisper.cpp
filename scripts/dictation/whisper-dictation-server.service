[Unit]
Description=Local dictation warm model server (Whisper or Phonon-2)
After=network.target
Before=whisper-dictation.service

[Service]
Type=notify
NotifyAccess=all
TimeoutStartSec=180
TimeoutStopSec=15
WatchdogSec=30
KillMode=mixed
KillSignal=SIGTERM
ExecStart=%SERVER_BIN%
Restart=on-failure
RestartSec=3
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=default.target
